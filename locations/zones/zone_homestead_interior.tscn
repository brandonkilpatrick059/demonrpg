[node name="Text2" type="Node" parent="interact_zone_1/run_interact" unique_id=1809961601]
script = ExtResource("14_kpw7i")
language_map = Array[String](["english"])
text = Array[String](["Are you ready to visit your [color=red]Older Sister[/color] this afternoon?"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text3" type="Node" parent="interact_zone_1/run_interact" unique_id=1903189487]
script = ExtResource("14_kpw7i")
language_map = Array[String](["english"])
text = Array[String](["She's been staying at [color=blue]Grandma's House[/color] for a week now."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text4" type="Node" parent="interact_zone_1/run_interact" unique_id=387186968]
script = ExtResource("14_kpw7i")
language_map = Array[String](["english"])
text = Array[String](["...Your [color=red]Sister[/color] has strayed very far from the path of grace."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text5" type="Node" parent="interact_zone_1/run_interact" unique_id=1178042514]
script = ExtResource("14_kpw7i")
language_map = Array[String](["english"])
text = Array[String](["I hope Grandma's wisdom has helped her find her way."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text6" type="Node" parent="interact_zone_1/run_interact" unique_id=795296125]
script = ExtResource("14_kpw7i")
language_map = Array[String](["english"])
text = Array[String](["But I fear that she won't be accepted back into [color=blue]The Church[/color]..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

