[node name="Text2" type="Node" parent="dialog/queue_1" unique_id=1965039532]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Well..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text3" type="Node" parent="dialog/queue_1" unique_id=876438445]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Ain't you just the spittin' image?"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text4" type="Node" parent="dialog/queue_1" unique_id=1057356686]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Yer lookin' fer yer [color=red]Sister[/color], ain't you?"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text5" type="Node" parent="dialog/queue_1" unique_id=5461448]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["She came through here not long ago."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text6" type="Node" parent="dialog/queue_1" unique_id=1613100778]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["We had a little chat..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="queue_2" type="Node" parent="dialog" unique_id=113466290 node_paths=PackedStringArray("texts")]
script = ExtResource("5_wvddu")
texts = [NodePath("Text"), NodePath("Text2"), NodePath("Text3"), NodePath("Text4"), NodePath("Text5"), NodePath("Text6"), NodePath("Text7"), NodePath("Text8"), NodePath("Text9")]

[node name="Text" type="Node" parent="dialog/queue_2" unique_id=960503870]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["You ain't got much hope if you wanna go after yer [color=red]Sister[/color]."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text2" type="Node" parent="dialog/queue_2" unique_id=494870839]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["She crossed over the gorge to [color=blue]Nineveh Town[/color]."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text3" type="Node" parent="dialog/queue_2" unique_id=347968105]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["She went across the [color=blue]Rail Bridge[/color]-"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text4" type="Node" parent="dialog/queue_2" unique_id=1626349701]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["...And destroyed it behind her."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text5" type="Node" parent="dialog/queue_2" unique_id=908477995]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["The rains have washed out the road south, and the river is high-"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text6" type="Node" parent="dialog/queue_2" unique_id=852982953]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["You ain't got no chance to make it on foot."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text7" type="Node" parent="dialog/queue_2" unique_id=1366243009]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["At least, going above ground."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text8" type="Node" parent="dialog/queue_2" unique_id=1509155881]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["There may still be a way through the [color=blue]Coal Mines[/color]."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text9" type="Node" parent="dialog/queue_2" unique_id=2110674614]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["But it's been a long time since I was last down there..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="queue_3" type="Node" parent="dialog" unique_id=349656126 node_paths=PackedStringArray("texts")]
script = ExtResource("5_wvddu")
texts = [NodePath("Text"), NodePath("Text2"), NodePath("Text3"), NodePath("Text4"), NodePath("Text5"), NodePath("Text6")]

[node name="Text" type="Node" parent="dialog/queue_3" unique_id=143133061]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["You wanna know the way through the old [color=blue]Coal Mines[/color], eh?"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text2" type="Node" parent="dialog/queue_3" unique_id=356974976 node_paths=PackedStringArray("script_node")]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Hehehe!"])
script_node = NodePath("play_laugh")
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="play_laugh" type="Node" parent="dialog/queue_3/Text2" unique_id=658753301]
script = ExtResource("7_flck8")
sound_stream = ExtResource("8_5dbpe")

[node name="Text3" type="Node" parent="dialog/queue_3" unique_id=435883269]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["My mining days are long behind me, miss."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text4" type="Node" parent="dialog/queue_3" unique_id=2115048033]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["I can't quite remember it now."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text5" type="Node" parent="dialog/queue_3" unique_id=205110204]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Back then I usta live in the town east of here-"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text6" type="Node" parent="dialog/queue_3" unique_id=220261849]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Back before the mines dried up and it became a [color=blue]Ghost Town[/color]."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="queue_4" type="Node" parent="dialog" unique_id=923039004 node_paths=PackedStringArray("texts")]
script = ExtResource("5_wvddu")
texts = [NodePath("Text"), NodePath("Text2"), NodePath("Text3"), NodePath("Text4"), NodePath("Text5"), NodePath("Text6"), NodePath("Text7")]

[node name="Text" type="Node" parent="dialog/queue_4" unique_id=520790799]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Seems like just yesterday..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text2" type="Node" parent="dialog/queue_4" unique_id=1157893739]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Me and all the boys usta go to [color=blue]The Estate[/color]-"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text3" type="Node" parent="dialog/queue_4" unique_id=1005136654]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["And try to catch a glimpse of [color=red]The Heiress[/color]."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text4" type="Node" parent="dialog/queue_4" unique_id=701696154]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["Everything about those days..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text5" type="Node" parent="dialog/queue_4" unique_id=633853772]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["The [color=blue]Mines[/color], the [color=blue]Town[/color], [color=red]The Heiress[/color]-"])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text6" type="Node" parent="dialog/queue_4" unique_id=1146339859]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["It's all so faded now."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

[node name="Text7" type="Node" parent="dialog/queue_4" unique_id=814108361]
script = ExtResource("6_o8uqu")
language_map = Array[String](["english"])
text = Array[String](["If only I could see her face again..."])
metadata/_custom_type_script = "uid://xtykxchs28xu"

